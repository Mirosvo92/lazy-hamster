# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DB_NAME?schema=public"

# AWS S3
AWS_S3_BUCKET=your-s3-bucket-name
AWS_S3_REGION=eu-north-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# OpenAI / LaoZhang proxy
OPENAI_API_KEY_LAO=your-openai-api-key
LAO_URL=https://api.laozhang.ai/v1

# Backend base URL (used for internal links, e.g. landing page injection)
API_BASE_URL=http://localhost:3001

# Image generation model (e.g. sora_image, gpt-image-1)
IMAGE_MODEL=sora_image
